# Neon pooled (Vercel queries). Never localhost in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon direct / non-pooled (prisma migrate). If you omit this on Vercel, the build uses DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require"
AUTH_SECRET="generate-a-long-random-string"

# iOS app (mobile/.env): the deployed Vercel origin, no trailing slash
# EXPO_PUBLIC_API_URL="https://your-app.vercel.app"
