# Neon pooled (Vercel + app queries) or local Docker:
# postgresql://ergcalc:ergcalc@localhost:5432/ergcalc
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
# Neon direct / non-pooled (migrations). Local Docker: same as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
AUTH_SECRET="generate-a-long-random-string"

# iOS app (mobile/.env): the deployed web origin, no trailing slash
# EXPO_PUBLIC_API_URL="https://your-app.vercel.app"
